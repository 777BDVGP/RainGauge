# PlatformIO build output + downloaded libraries
.pio/

# VS Code files PlatformIO regenerates
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Machine-local tool settings
.claude/settings.local.json

# Own WiFi networks / passwords (see src/wifi_secrets.example.h) - never commit
**/wifi_secrets.h

# Own upload targets (see private.example.ini) - never commit
**/private.ini

# Built firmware files (tools/export_bin.py) - the published ones are in docs/firmware/
**/firmware_out/

# Board-specific file system images (WiFi passwords!) - never commit
**/data/
